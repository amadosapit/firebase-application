@{
    ViewBag.Title = "Contact";
}

<!-- ===== PAGE HEADER ===== -->
<section class="page-header" aria-labelledby="contact-heading">
    <div class="container">
        <div class="breadcrumb-nav" role="navigation" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <i class="material-icons" aria-hidden="true">chevron_right</i>
            <span aria-current="page">Contact</span>
        </div>
        <h1 id="contact-heading">Contact &amp; Support</h1>
        <p>Get in touch with the project team.</p>
    </div>
</section>

<!-- ===== MAIN CONTENT ===== -->
<section class="page-content">
    <div class="container">

        <div class="row" style="margin-bottom: var(--space-xl);">

            <!-- Email Support -->
            <div class="col s12 m6 l4" style="margin-bottom: var(--space-lg);">
                <div class="contact-card">
                    <div class="contact-card-icon" aria-hidden="true">
                        <i class="material-icons">support_agent</i>
                    </div>
                    <div>
                        <h6>Technical Support</h6>
                        <p>For issues or bugs related to the application:</p>
                        <a href="mailto:Support@example.com">Support@example.com</a>
                    </div>
                </div>
            </div>

            <!-- Marketing -->
            <div class="col s12 m6 l4" style="margin-bottom: var(--space-lg);">
                <div class="contact-card">
                    <div class="contact-card-icon" aria-hidden="true">
                        <i class="material-icons">campaign</i>
                    </div>
                    <div>
                        <h6>General Inquiries</h6>
                        <p>For general inquiries and collaboration:</p>
                        <a href="mailto:Marketing@example.com">Marketing@example.com</a>
                    </div>
                </div>
            </div>

            <!-- Project Info -->
            <div class="col s12 m6 l4" style="margin-bottom: var(--space-lg);">
                <div class="contact-card">
                    <div class="contact-card-icon" aria-hidden="true">
                        <i class="material-icons">school</i>
                    </div>
                    <div>
                        <h6>Academic Project</h6>
                        <p>This is a student project developed for the 3ITF Web Application Development course.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Info note -->
        <div class="row">
            <div class="col s12 l8 offset-l2">
                <div class="info-card">
                    <i class="material-icons" aria-hidden="true">info</i>
                    <p>
                        This application was developed as part of an academic project. The contact information above is for demonstration purposes. For actual project-related concerns, please reach out to your course instructor or project team members directly.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
</main>