            <div class="col s12 center-align">
                <a href="/ITFApplication/MainPage" class="btn waves-effect waves-light" style="background-color: var(--color-primary); border-radius: var(--radius-md); font-weight: 600; text-transform: none; letter-spacing: 0.3px; height: 44px; line-height: 44px; padding: 0 28px; font-size: var(--font-size-md);">
                    <i class="material-icons right" aria-hidden="true">arrow_forward</i>
                    Open Employee Manager
